# Copy to .env and fill in. Never commit real secrets.
# Frigate 0.18 authentication token (JWT). Required for collection.
FRIGATE_TOKEN=change-me

# Optional: override config file location.
# FRIGATE_LEARN_CONFIG=

# Optional: path to migrations dir (default: <config_dir>/../migrations)
# FRIGATE_LEARN_MIGRATIONS=

# Optional: Bearer token for the remote SAM server (audit.models.sam.api_key).
# SAM_SERVER_KEY=change-me